# Copy the values from the service-account key you download in the Firebase
# console (Project settings -> Service accounts -> Generate new private key).
#
#   Locally:            save this as .streamlit/secrets.toml (git-ignored)
#   Streamlit Cloud:    paste it into the app's Settings -> Secrets box
#
# Without this section the app saves mocks to .records/records.json instead.

[firebase]
type = "service_account"
project_id = "ssc-mock-analyser-nk"
private_key_id = "..."
private_key = """-----BEGIN PRIVATE KEY-----
...
-----END PRIVATE KEY-----
"""
client_email = "firebase-adminsdk-...@ssc-mock-analyser-nk.iam.gserviceaccount.com"
client_id = "..."
token_uri = "https://oauth2.googleapis.com/token"
